<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>MarkPad</AssemblyName>
    <RootNamespace>MarkPad</RootNamespace>
    <Description>MarkPad — a minimal markdown editor with a git workflow for GitHub.</Description>
    <ApplicationIcon>MarkPad.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- AvalonEdit: the WPF text editor control (line numbers, syntax highlighting).
         NOTE: the NuGet package ID is "AvalonEdit", not "ICSharpCode.AvalonEdit" —
         the project moved to the shorter ID. The assembly and namespaces are
         still ICSharpCode.AvalonEdit, so the code does not change. -->
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <!-- Markdig: markdown -> HTML for the preview toggle (verified 0.40.0 on nuget.org). -->
    <PackageReference Include="Markdig" Version="0.40.0" />
    <!-- WebView2: Edge/Chromium renderer for the preview (verified 1.0.3595.46). -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3595.46" />
    <!-- Velopack: Setup.exe installer + auto-updates from GitHub Releases
         (verified 1.2.161, latest stable Sep 29, 2026; 1.2.158 is deprecated
         and 1.3.x is prerelease, so both are skipped). -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <!-- Markdown highlighting definitions, one per theme. Embedded so the app
         is a single exe with no loose files to lose. -->
    <EmbeddedResource Include="Highlighting\Markdown-Light.xshd" />
    <EmbeddedResource Include="Highlighting\Markdown-Dark.xshd" />
  </ItemGroup>

  <ItemGroup>
    <!-- App icon: the exe icon (ApplicationIcon above) and the window icon
         (MainWindow Icon) both use this file. -->
    <Resource Include="MarkPad.ico" />
  </ItemGroup>

</Project>
