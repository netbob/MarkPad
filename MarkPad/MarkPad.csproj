<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>MarkPad</AssemblyName>
    <RootNamespace>MarkPad</RootNamespace>
    <Description>MarkPad — a minimal markdown editor with a git workflow for GitHub.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- AvalonEdit: the WPF text editor control (line numbers, syntax highlighting).
         NOTE: the NuGet package ID is "AvalonEdit", not "ICSharpCode.AvalonEdit" —
         the project moved to the shorter ID. The assembly and namespaces are
         still ICSharpCode.AvalonEdit, so the code does not change. -->
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>

  <ItemGroup>
    <!-- Markdown highlighting definitions, one per theme. Embedded so the app
         is a single exe with no loose files to lose. -->
    <EmbeddedResource Include="Highlighting\Markdown-Light.xshd" />
    <EmbeddedResource Include="Highlighting\Markdown-Dark.xshd" />
  </ItemGroup>

</Project>
