<?xml version="1.0" encoding="utf-8"?>
<!-- MarkPad markdown highlighting (dark theme).
     Same rules as Markdown-Light.xshd; only the colors differ. -->
<SyntaxDefinition name="Markdown" extensions=".md;.markdown" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Header" foreground="#6CB6FF" fontWeight="bold" />
  <Color name="Bold" foreground="#FFFFFF" fontWeight="bold" />
  <Color name="Italic" foreground="#D4D4D4" fontStyle="italic" />
  <Color name="Code" foreground="#CE9178" background="#2D2D2D" />
  <Color name="Link" foreground="#4EA6FF" />
  <Color name="List" foreground="#9ECE6A" />
  <Color name="Quote" foreground="#6A9955" fontStyle="italic" />
  <Color name="Rule" foreground="#808080" />

  <RuleSet ignoreCase="false">
    <!-- Fenced code block: ``` ... ``` -->
    <Span name="CodeFence" color="Code" begin="^```" end="^```" />
    <!-- Inline code -->
    <Span name="Code" color="Code" begin="`" end="`" />
    <!-- Bold, then italic (bold must win on **). -->
    <Span name="Bold" color="Bold" begin="\*\*" end="\*\*" />
    <Span name="Bold" color="Bold" begin="__" end="__" />
    <Span name="Italic" color="Italic" begin="\*" end="\*" />
    <Span name="Italic" color="Italic" begin="_" end="_" />
    <!-- Headers -->
    <Rule name="Header" color="Header" regex="^#{1,6}\s+.*$" />
    <!-- Images before links (an image is a link with a ! in front). -->
    <Rule name="Link" color="Link" regex="!\[[^\]]*\]\([^)]*\)" />
    <Rule name="Link" color="Link" regex="\[[^\]]*\]\([^)]*\)" />
    <!-- Lists, blockquotes, horizontal rules -->
    <Rule name="List" color="List" regex="^\s*([-*+]|\d+[.)])\s" />
    <Rule name="Quote" color="Quote" regex="^\s*&gt;" />
    <Rule name="Rule" color="Rule" regex="^\s*([-*_]){3,}\s*$" />
  </RuleSet>
</SyntaxDefinition>
