<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="WindowForeground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="MenuBackground" Color="#F3F3F3" />
    <SolidColorBrush x:Key="MenuForeground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="MenuHighlightBrush" Color="#E5E5E5" />
    <SolidColorBrush x:Key="LinkBrush" Color="#0563C1" />
    <SolidColorBrush x:Key="StatusBackground" Color="#F3F3F3" />
    <SolidColorBrush x:Key="StatusForeground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="BorderBrush" Color="#CCCCCC" />
    <SolidColorBrush x:Key="AccentBrush" Color="#007ACC" />
    <SolidColorBrush x:Key="EditorBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="EditorForeground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="LineNumberForeground" Color="#808080" />
</ResourceDictionary>
