<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="WindowForeground" Color="#D4D4D4" />
    <SolidColorBrush x:Key="MenuBackground" Color="#252526" />
    <SolidColorBrush x:Key="MenuForeground" Color="#D4D4D4" />
    <SolidColorBrush x:Key="MenuHighlightBrush" Color="#3E3E3E" />
    <SolidColorBrush x:Key="LinkBrush" Color="#4EA6FF" />
    <SolidColorBrush x:Key="StatusBackground" Color="#007ACC" />
    <SolidColorBrush x:Key="StatusForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3E3E3E" />
    <SolidColorBrush x:Key="AccentBrush" Color="#007ACC" />
    <SolidColorBrush x:Key="EditorBackground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="EditorForeground" Color="#D4D4D4" />
    <SolidColorBrush x:Key="LineNumberForeground" Color="#858585" />
    <!-- System brushes the default menu template actually paints with. The popup
         panel and hover colors come from these, not from the MenuItem style, so
         without them a dark app gets a light system popup. Light mode is left
         alone: these overrides exist only in the dark dictionary. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#252526" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#D4D4D4" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#007ACC" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#808080" />
    <!-- Explicit context-menu panel: if the system-brush override above does not
         reach a popup, this still paints the panel dark. Dark-only, like the
         overrides; light mode keeps the system light panel. -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="#252526" />
        <Setter Property="Foreground" Value="#D4D4D4" />
        <Setter Property="BorderBrush" Value="#3E3E3E" />
    </Style>
</ResourceDictionary>
