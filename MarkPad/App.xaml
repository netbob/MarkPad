<Application x:Class="MarkPad.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Default theme; MainWindow swaps this at startup from settings. -->
                <ResourceDictionary Source="pack://application:,,,/Themes/Light.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Menu colors at application level: dropdown popups do not reliably
                 see Window resources, so the style lives here to reach them. -->
            <Style TargetType="MenuItem">
                <Setter Property="Foreground" Value="{DynamicResource MenuForeground}" />
                <Setter Property="Background" Value="{DynamicResource MenuBackground}" />
                <!-- The default item border renders light in dark mode (the white
                     frames around options); transparent keeps hover feedback on the
                     background alone. Light items already look borderless. -->
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
